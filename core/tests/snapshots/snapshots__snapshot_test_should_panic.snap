#[::core::prelude::v1::test]
fn it_panics() -> ::std::process::ExitCode {
    fn body_fn() {
        panic!("boom");
    }
    ::test_fork::test_fork_core::fork(
            ::test_fork::test_fork_core::fork_id!(),
            ::test_fork::test_fork_core::fork_test_name!(it_panics),
            {
                fn should_panic_fn() -> ::std::process::ExitCode {
                    ::test_fork::test_fork_core::run_should_panic(
                        body_fn,
                        ::std::option::Option::None,
                    )
                }
                should_panic_fn
            } as fn() -> _,
        )
        .expect("forking test failed")
}
